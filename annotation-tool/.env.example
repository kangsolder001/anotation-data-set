# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=annotation_db
POSTGRES_USER=annotation_user
POSTGRES_PASSWORD=ganti_password_aman_ini

# ── Secret key (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=ganti_dengan_string_random_panjang_minimal_32_karakter

# ── Port aplikasi
APP_PORT=3005

# ── Akun Admin (dibuat otomatis saat startup, idempoten)
ADMIN_EMAIL=admin@kgs.id
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator KGS
